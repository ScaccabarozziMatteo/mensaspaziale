# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out
*.tsbuildinfo

# Node
/node_modules
npm-debug.log*
yarn-error.log*
yarn-debug.log*
pnpm-debug.log*
.firebase/

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.swp
*.swo
*~
.venv/
venv/

# Visual Studio Code
# Local editor setup, not shared with the team.
.vscode/
.history/*

# Local environment overrides
# src/environment/environment.ts holds the shared, non-secret config that is
# bundled into the app. Anything machine-specific or secret belongs in an
# ignored *.local.ts sibling, wired up via fileReplacements in angular.json.
src/environment/*.local.ts
.env
.env.*
!.env.example

# Test output
/coverage
/libpeerconnection.log
testem.log
__screenshots__/
/playwright-report/
/test-results/

# Logs
*.log
firebase-debug.log
ui-debug.log

# Caches
/.angular/cache
.sass-cache/
/connect.lock
/typings

# System files
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
